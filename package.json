{
  "name": "json-prism-deck",
  "version": "1.0.5",
  "private": true,
  "description": "本地离线 JSON 格式化、压缩、树形预览与元数据分析 Chrome 扩展。",
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "build": "vite build",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify": "npm run lint && npm run test && npm run build && npm run verify:dist",
    "release:prepare": "node scripts/sync-version.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:notes": "node scripts/extract-release-notes.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "vite": "^8.1.4"
  }
}
